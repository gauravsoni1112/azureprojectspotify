{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF-AzureProjectSpotify"
		},
		"linked_service_azureprojectspotify_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linked_service_azureprojectspotify_datalake'"
		},
		"linked_service_database_azureprojectspotify_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linked_service_database_azureprojectspotify'"
		},
		"linked_service_azureprojectspotify_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sgazureprojectspotify.dfs.core.windows.net/"
		},
		"linked_service_database_azureprojectspotify_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "databaseserver-azureprojectspotify.database.windows.net"
		},
		"linked_service_database_azureprojectspotify_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "database_azureprojectspotify"
		},
		"linked_service_database_azureprojectspotify_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admingaurav"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DF-AzureProjectSpotify_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linked_service_azureprojectspotify_datalake_accountKey": {
						"value": "[parameters('linked_service_azureprojectspotify_datalake_accountKey')]"
					},
					"linked_service_database_azureprojectspotify_password": {
						"value": "[parameters('linked_service_database_azureprojectspotify_password')]"
					},
					"linked_service_azureprojectspotify_datalake_properties_typeProperties_url": {
						"value": "[parameters('linked_service_azureprojectspotify_datalake_properties_typeProperties_url')]"
					},
					"linked_service_database_azureprojectspotify_properties_typeProperties_server": {
						"value": "[parameters('linked_service_database_azureprojectspotify_properties_typeProperties_server')]"
					},
					"linked_service_database_azureprojectspotify_properties_typeProperties_database": {
						"value": "[parameters('linked_service_database_azureprojectspotify_properties_typeProperties_database')]"
					},
					"linked_service_database_azureprojectspotify_properties_typeProperties_userName": {
						"value": "[parameters('linked_service_database_azureprojectspotify_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}